      "provider": {
        "id": "openrouter",
        "baseUrl": "https://openrouter.ai/api/v1",
        "protocol": "responses",
        "envKey": "OPENROUTER_API_KEY"
      }
    },
    "builder": {
      "runtime": "codex",
      "model": "REPLACE_WITH_CHEAP_CODING_MODEL",
