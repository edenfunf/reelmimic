        "id": "openrouter",
        "baseUrl": "https://openrouter.ai/api/v1",
        "protocol": "responses",
        "envKey": "OPENROUTER_API_KEY"
      }
    },
    "reviewer": {
      "runtime": "codex",
      "model": "REPLACE_WITH_VISION_MODEL",
      "vision": true,
      "provider": {
        "id": "openrouter",
        "baseUrl": "https://openrouter.ai/api/v1",
        "protocol": "responses",
        "envKey": "OPENROUTER_API_KEY"
      }
    },
    "backup": {
