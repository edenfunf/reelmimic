{
  "name": "reelmimic",
  "private": true,
  "type": "module",
  "scripts": {
    "server": "node server/index.ts",
    "web": "vite web --port 5173",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "start": "npm run build && node server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "lint": "eslint .",
    "test": "node --test --experimental-test-module-mocks \"server/**/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm test",
    "doctor": "node scripts/doctor.mjs",
    "publish": "node scripts/publish.mjs",
    "setup": "npm install && node scripts/doctor.mjs"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "opencc-js": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
