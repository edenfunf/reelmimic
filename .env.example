# Docker only: copy to .env next to compose.yaml and uncomment what you need. Leave unused lines commented out
# (an empty value still counts as set).
# Instead of logging in inside the container, the AI directors can use one of these:
# CLAUDE_CODE_OAUTH_TOKEN=   # run `claude setup-token` on your own computer (uses your Claude subscription)
# ANTHROPIC_API_KEY=         # or pay per use with an API key
# OPENAI_API_KEY=            # Codex with an API key
# Any key from secrets.example.json works here too, e.g.
# YATING_KEY=
# DISCORD_WEBHOOK_URL=
